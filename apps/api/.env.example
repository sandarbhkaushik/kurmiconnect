# Database
DATABASE_URL=postgresql+asyncpg://kurmi:kurmi_dev@localhost:5432/kurmi

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
